#!/usr/bin/env bash
#
# herdr-mark — tmux-style marked pane for herdr.
#
#   herdr-mark toggle        mark the current pane, or unmark it if it is marked
#   herdr-mark join <dir>    move the marked pane next to the current pane:
#                            right | down | left | up of it
#   herdr-mark swap          swap the marked pane with the current pane
#   herdr-mark clear         unmark whatever is marked
#   herdr-mark get           print the marked pane id (exit 1 if none)
#
# The "current pane" is the focused pane when run as a plugin action
# ($HERDR_PANE_ID) or from a `type = "shell"` binding ($HERDR_ACTIVE_PANE_ID).
# From a shell inside herdr it is the pane that shell runs in.
#
# The mark lives on the pane itself as display-only metadata from the source
# `user.herdr-mark`: a `mark` token (found again with `pane list`) and a border
# title (the visible marker). It follows the pane when it moves and disappears
# when the pane closes, so there is no state file.
#
# Options, from the environment or KEY=VALUE lines in
# $HERDR_PLUGIN_CONFIG_DIR/config (environment wins):
#   HERDR_MARK_TITLE   border title of the marked pane   (default: "◆ marked")
#   HERDR_MARK_NOTIFY  1 = show a herdr notification per action, 0 = don't
#
# Requires herdr >= 0.9.1 and jq.

set -euo pipefail

SOURCE="user.herdr-mark"
HERDR="${HERDR_BIN_PATH:-herdr}"

usage() {
  sed -n '3,10s/^# \{0,1\}//p' "${BASH_SOURCE[0]}" >&2
  exit 2
}

load_config() {
  local file="${HERDR_PLUGIN_CONFIG_DIR:-}/config" key value
  [[ -n ${HERDR_PLUGIN_CONFIG_DIR:-} && -f $file ]] || return 0
  while IFS='=' read -r key value; do
    value=${value%\"}
    value=${value#\"}
    case $key in
      HERDR_MARK_TITLE) : "${HERDR_MARK_TITLE:=$value}" ;;
      HERDR_MARK_NOTIFY) : "${HERDR_MARK_NOTIFY:=$value}" ;;
    esac
  done < <(grep -E '^[A-Z_]+=' "$file" || true)
}

h() { "$HERDR" "$@"; }

notify() {
  echo "herdr-mark: $1${2:+: $2}" >&2
  # A lone pane has no border to carry the marker, so say what happened.
  [[ $NOTIFY == 1 ]] || return 0
  h notification show "$1" ${2:+--body "$2"} --sound none >/dev/null 2>&1 || true
}

fail() {
  restore_view
  notify "$1" "${2:-}"
  exit 1
}

restore_view() {
  [[ -n ${RESTORE_WS:-} ]] || return 0
  local current current_ws current_tab
  current=$(h api snapshot 2>/dev/null) || return 0
  current_ws=$(jq -r '.result.snapshot.focused_workspace_id // empty' <<<"$current")
  current_tab=$(jq -r '.result.snapshot.focused_tab_id // empty' <<<"$current")
  [[ $current_ws == "$RESTORE_WS" ]] || h workspace focus "$RESTORE_WS" >/dev/null 2>&1 || true
  [[ -z ${RESTORE_TAB:-} || $current_tab == "$RESTORE_TAB" ]] ||
    h tab focus "$RESTORE_TAB" >/dev/null 2>&1 || true
}

marked_panes() {
  h pane list | jq -r '.result.panes[] | select(.tokens.mark == "1") | .pane_id'
}

marked() { marked_panes | head -n1; }

set_mark() {
  h pane report-metadata "$1" --source "$SOURCE" --title "$TITLE" --token mark=1 >/dev/null
}

clear_mark() {
  h pane report-metadata "$1" --source "$SOURCE" --clear-title --clear-token mark \
    >/dev/null 2>&1 || true
}

clear_all() {
  local p
  while read -r p; do
    [[ -n $p ]] && clear_mark "$p"
  done < <(marked_panes)
}

current_pane() {
  local p=${HERDR_ACTIVE_PANE_ID:-${HERDR_PANE_ID:-}}
  if [[ -z $p ]]; then
    p=$(h pane current | jq -r '.result.pane.pane_id // empty')
  fi
  [[ -n $p ]] || fail "No current pane" "run inside herdr"
  printf '%s\n' "$p"
}

pane_tab() {
  h pane get "$1" 2>/dev/null | jq -r '.result.pane.tab_id // empty'
}

tab_zoomed() {
  h pane layout --pane "$1" | jq -r '.result.layout.zoomed'
}

# Sets M/M_TAB (marked) and T/T_TAB (current), refusing up front the cases
# herdr would ignore: no mark, marked == current, or a zoomed tab.
resolve() {
  T=$(current_pane)
  T_TAB=$(pane_tab "$T")
  [[ -n $T_TAB ]] || fail "Current pane not found" "$T"
  M=$(marked)
  [[ -n $M ]] || fail "No marked pane" "mark one first"
  [[ $M != "$T" ]] || fail "The marked pane is the current pane" "focus another pane first"
  M_TAB=$(pane_tab "$M")
  [[ -n $M_TAB ]] || fail "Marked pane not found" "$M"
  [[ $(tab_zoomed "$T") == false ]] || fail "This tab is zoomed" "unzoom it first"
  [[ $(tab_zoomed "$M") == false ]] || fail "The marked pane's tab is zoomed" "unzoom it first"
}

# try_move <pane move args…>: run `herdr pane move`. On success print the moved
# pane's id (it changes when the pane enters another workspace); on failure
# print why and return 1.
try_move() {
  local out
  if ! out=$(h pane move "$@" 2>&1); then
    printf '%s\n' "${out:-herdr pane move failed}"
    return 1
  fi
  if [[ $(jq -r '.result.move_result.changed' <<<"$out") != true ]]; then
    jq -r '.result.move_result.reason // "herdr did not move the pane"' <<<"$out"
    return 1
  fi
  jq -r '.result.move_result.pane.pane_id' <<<"$out"
}

# try_swap <a> <b>: swap two panes in one tab; on failure print why, return 1.
try_swap() {
  local out
  out=$(h pane swap --source-pane "$1" --target-pane "$2" 2>&1) || {
    printf '%s\n' "${out:-herdr pane swap failed}"
    return 1
  }
  [[ $(jq -r '.result.swap.changed' <<<"$out") == true ]] || {
    jq -r '.result.swap.reason // "herdr did not swap the panes"' <<<"$out"
    return 1
  }
}

try_split() {
  local out
  out=$(h pane split "$1" --direction down --no-focus 2>&1) || {
    printf '%s\n' "${out:-herdr pane split failed}"
    return 1
  }
  jq -r '.result.pane.pane_id // empty' <<<"$out"
}

try_close() {
  h pane close "$1" >/dev/null 2>&1
}

# A peer token makes the second participant discoverable if a move changes its
# public id before an interrupted swap can clear it.
set_peer() {
  h pane report-metadata "$1" --source "$SOURCE" --token swap-peer=1 >/dev/null
}

clear_peer() {
  h pane report-metadata "$1" --source "$SOURCE" --clear-token swap-peer >/dev/null 2>&1 || true
}

clear_peers() {
  local p
  while read -r p; do
    [[ -n $p ]] && clear_peer "$p"
  done < <(h pane list | jq -r '.result.panes[] | select(.tokens["swap-peer"] == "1") | .pane_id')
}

# plan_leaver <layout JSON> <pane id>: print kind, anchor, direction, ratio,
# fixup pane, and cost as TSV. A move removes a leaf and collapses its parent.
# The smallest split rectangle containing that leaf is its parent. A split
# containing exactly two leaves is a cherry that can be rebuilt by one move.
plan_leaver() {
  jq -er --arg id "$2" '
    def inside($a; $b):
      $a.x >= $b.x and $a.y >= $b.y and
      ($a.x + $a.width) <= ($b.x + $b.width) and
      ($a.y + $a.height) <= ($b.y + $b.height);
    .result.layout as $l
    | ($l.panes | map(select(.pane_id == $id)) | first) as $p
    | if $p == null or ($l.splits | length) != (($l.panes | length) - 1)
         or any($l.panes[]; .rect.width <= 0 or .rect.height <= 0)
      then error("invalid pane layout") else . end
    | [$l.splits[] | select(inside($p.rect; .rect))] as $parents
    | if ($parents | length) == 0 then error("pane has no parent split") else . end
    | ($parents | min_by(.rect.width * .rect.height)) as $parent
    | [$l.panes[] | select(.pane_id != $id and inside(.rect; $parent.rect))] as $siblings
    | if ($siblings | length) == 1 then
        ($siblings[0].pane_id) as $s
        | (if $parent.direction == "right" then $p.rect.x == $parent.rect.x
           else $p.rect.y == $parent.rect.y end) as $first
        | [if $first then "leaf-first" else "leaf-second" end,
           $s, $parent.direction, ($parent.ratio | tostring), $s,
           (if $first then 1 else 0 end)] | @tsv
      else
        [ $l.splits[] as $split
          | [$l.panes[] | select(inside(.rect; $split.rect))] as $members
          | select($members | length == 2)
          | ($members | sort_by(if $split.direction == "right" then .rect.x else .rect.y end)) as $pair
          | [$pair[0].pane_id, $pair[1].pane_id, $split.direction,
             ($split.ratio | tostring)]
        ] | first as $cherry
        | if $cherry == null then error("no cherry in pane layout") else . end
        | ["cherry", $cherry[0], $cherry[2], $cherry[3], $cherry[1], 2] | @tsv
      end
  ' <<<"$1"
}

cmd_toggle() {
  local p m
  p=$(current_pane)
  m=$(marked)
  clear_all
  if [[ $m == "$p" ]]; then
    notify "Unmarked $p"
  else
    set_mark "$p"
    notify "Marked $p" "focus another pane, then join or swap"
  fi
}

cmd_join() {
  local dir=${1:-} split out parked=0
  case $dir in
    right | left) split=right ;;
    down | up) split=down ;;
    *) usage ;;
  esac
  resolve

  # herdr ignores a move within one tab (reason "same_tab"), so park the pane
  # in a new tab first. That tab closes once the pane leaves it, and a pane
  # keeps its id while it stays in one workspace.
  if [[ $M_TAB == "$T_TAB" ]]; then
    out=$(try_move "$M" --new-tab --no-focus) || fail "Couldn't move the marked pane" "$out"
    M=$out
    parked=1
  fi

  if ! out=$(try_move "$M" --tab "$T_TAB" --target-pane "$T" --split "$split" --focus); then
    ((parked)) || fail "Couldn't join the marked pane" "$out"
    # The pane is in the parking tab: put it back in its own tab (its old
    # position is gone) or, failing that, say where it is. It stays marked.
    if try_move "$M" --tab "$M_TAB" --split right --no-focus >/dev/null; then
      fail "Couldn't join the marked pane ($out)" "it is back in its tab, still marked"
    fi
    fail "Couldn't join the marked pane ($out)" "it is still marked, in tab $(pane_tab "$M")"
  fi
  M=$out

  # herdr only splits to the right of or below the target; swap for left/up.
  if [[ $dir == left || $dir == up ]] && ! out=$(try_swap "$M" "$T"); then
    fail "Joined $M $split of $T, not $dir" "the swap failed ($out); it is still marked"
  fi

  clear_mark "$M"
  notify "Joined $M $dir of $T"
}

cmd_swap() {
  local out m_layout t_layout m_count t_count m_plan t_plan
  local kind anchor dir ratio fixup _cost x p_tab q_tab rollback rollback_reason="" inventory
  local p_focus q_focus leaver_marked=1
  resolve
  if [[ $M_TAB == "$T_TAB" ]]; then
    out=$(try_swap "$M" "$T") || fail "Couldn't swap" "$out"
    clear_mark "$M"
    notify "Swapped $M and $T"
    return
  fi

  local view
  view=$(h api snapshot) || fail "Couldn't inspect the focused workspace"
  RESTORE_WS=$(jq -r '.result.snapshot.focused_workspace_id // empty' <<<"$view")
  RESTORE_TAB=$(jq -r '.result.snapshot.focused_tab_id // empty' <<<"$view")
  [[ -n $RESTORE_WS ]] || fail "Couldn't inspect the focused workspace"

  m_layout=$(h pane layout --pane "$M") || fail "Couldn't inspect the marked pane's layout"
  t_layout=$(h pane layout --pane "$T") || fail "Couldn't inspect the current pane's layout"
  m_count=$(jq '.result.layout.panes | length' <<<"$m_layout")
  t_count=$(jq '.result.layout.panes | length' <<<"$t_layout")
  [[ $m_count -ge 1 && $t_count -ge 1 ]] || fail "Couldn't inspect both pane layouts"
  inventory=$(h pane list) || fail "Couldn't inspect panes before swapping"
  if jq -e '.result.panes[] | select(.tokens.swap_helper == "1" or .tokens["swap-peer"] == "1")' <<<"$inventory" >/dev/null; then
    fail "An earlier swap is unfinished" "recover its panes, then run herdr-mark clear before swapping again"
  fi
  set_peer "$T" || fail "Couldn't mark the swap peer" "$T"

  # Two lone panes need a temporary leaf to keep the marked tab (and possibly
  # its workspace) alive while the marked pane moves out.
  if ((m_count == 1 && t_count == 1)); then
    x=$(try_split "$M") || { clear_peer "$T"; fail "Couldn't create a temporary pane" "$x"; }
    [[ -n $x ]] || { clear_peer "$T"; fail "Herdr didn't return a temporary pane id"; }
    if ! h pane report-metadata "$x" --source "$SOURCE" --token swap_helper=1 >/dev/null; then
      try_close "$x" || true
      clear_peer "$T"
      fail "Couldn't tag the temporary pane" "$x"
    fi
    if ! out=$(try_move "$M" --tab "$T_TAB" --target-pane "$T" --split right --focus); then
      try_close "$x" || true
      clear_peer "$T"
      fail "Couldn't move the marked pane" "$out"
    fi
    M=$out
    if ! out=$(try_move "$T" --tab "$M_TAB" --target-pane "$x" --split right --no-focus); then
      if rollback=$(try_move "$M" --tab "$M_TAB" --target-pane "$x" --split right --no-focus); then
        M=$rollback
        if try_close "$x"; then
          clear_peer "$T"
          fail "Couldn't move the swap peer ($out)" "original layout restored; $M is still marked"
        fi
        fail "Couldn't move the swap peer ($out)" "recovery returned $M, but temporary pane $x could not be closed"
      fi
      fail "Couldn't move the swap peer ($out)" "recovery move failed ($rollback); $M is marked and temporary pane $x remains"
    fi
    T=$out
    if ! try_close "$x" && ! try_close "$x"; then
      fail "The panes moved, but the temporary pane could not be closed" "$x; $M is still marked"
    fi
  else
    if ((m_count > 1)); then
      m_plan=$(plan_leaver "$m_layout" "$M") || { clear_peer "$T"; fail "Couldn't plan the marked pane's move"; }
    fi
    if ((t_count > 1)); then
      t_plan=$(plan_leaver "$t_layout" "$T") || { clear_peer "$T"; fail "Couldn't plan the current pane's move"; }
    fi
    if ((m_count > 1)) && { ((t_count == 1)) || [[ ${m_plan##*$'\t'} -le ${t_plan##*$'\t'} ]]; }; then
      IFS=$'\t' read -r kind anchor dir ratio fixup _cost <<<"$m_plan"
      P=$M Q=$T p_tab=$M_TAB q_tab=$T_TAB
    else
      IFS=$'\t' read -r kind anchor dir ratio fixup _cost <<<"$t_plan"
      P=$T Q=$M p_tab=$T_TAB q_tab=$M_TAB
      leaver_marked=0
    fi
    p_focus=--no-focus q_focus=--no-focus
    ((leaver_marked)) && p_focus=--focus || q_focus=--focus

    if [[ $kind == cherry ]] && ! out=$(try_swap "$P" "$fixup"); then
      clear_peer "$T"
      fail "Couldn't prepare the swap" "$out"
    fi
    if ! out=$(try_move "$P" --tab "$q_tab" --target-pane "$Q" --split right "$p_focus"); then
      if [[ $kind == cherry ]] && ! rollback_reason=$(try_swap "$P" "$fixup"); then
        fail "Couldn't move the pane ($out)" "the setup swap could not be undone ($rollback_reason); $M is still marked"
      fi
      clear_peer "$T"
      fail "Couldn't move the pane" "$out"
    fi
    P=$out
    if ! out=$(try_move "$Q" --tab "$p_tab" --target-pane "$anchor" --split "$dir" --ratio "$ratio" "$q_focus"); then
      if rollback=$(try_move "$P" --tab "$p_tab" --target-pane "$anchor" --split "$dir" --ratio "$ratio" --no-focus); then
        P=$rollback
        if [[ $kind == leaf-second ]] || rollback_reason=$(try_swap "$P" "$fixup"); then
          ((leaver_marked)) && M=$P || T=$P
          clear_peer "$T"
          fail "Couldn't move the second pane ($out)" "original layout restored; $M is still marked"
        fi
      else
        rollback_reason=$rollback
      fi
      ((leaver_marked)) && M=$P || T=$P
      fail "Couldn't move the second pane ($out)" "recovery failed${rollback_reason:+ ($rollback_reason)}; $M is still marked"
    fi
    Q=$out
    if ((leaver_marked)); then
      M=$P T=$Q
    else
      M=$Q T=$P
    fi
    if [[ $kind != leaf-second ]]; then
      if ! out=$(try_swap "$Q" "$fixup") && ! out=$(try_swap "$Q" "$fixup"); then
        fail "The panes moved, but their positions need one more swap" \
          "$Q and $fixup in tab $p_tab; $M is still marked ($out)"
      fi
    fi
  fi

  # --focus selects the marked pane. A caller testing an unfocused workspace
  # should not be pulled away from the workspace they were viewing.
  restore_view
  clear_mark "$M"
  clear_peer "$T"
  notify "Swapped $M and $T"
}

main() {
  command -v jq >/dev/null || { echo "herdr-mark: jq is required" >&2; exit 1; }
  load_config
  TITLE=${HERDR_MARK_TITLE:-◆ marked}
  NOTIFY=${HERDR_MARK_NOTIFY:-1}

  case ${1:-} in
    toggle) cmd_toggle ;;
    join) cmd_join "${2:-}" ;;
    swap) cmd_swap ;;
    clear) clear_all; clear_peers ;;
    get)
      local m
      m=$(marked)
      [[ -n $m ]] || exit 1
      printf '%s\n' "$m"
      ;;
    *) usage ;;
  esac
}

main "$@"
